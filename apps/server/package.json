{
  "name": "@medtryx/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch dist/index.js",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "db:migrate": "node dist/cli/migrate.js",
    "db:create-owner": "node dist/cli/create-owner.js"
  },
  "dependencies": {
    "@medtryx/shared": "*",
    "argon2": "0.45.1",
    "better-sqlite3": "13.0.3",
    "cookie-parser": "1.4.7",
    "decimal.js": "10.6.0",
    "dotenv": "18.0.4",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "supertest": "7.1.4"
  }
}
