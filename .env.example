# Copy to .env for local development. APP_ENV isolates each database file.
APP_ENV=development
# Optional until a sale applies SC/PWD benefits. Generate a unique 32-byte hex key per environment.
CUSTOMER_ID_ENCRYPTION_KEY=
# Live requires a restricted key file outside the repository instead of this direct value.
CUSTOMER_ID_ENCRYPTION_KEY_FILE=
# Development/test default to ignored data/. Live requires an absolute local path outside this repository.
MEDTRYX_DATA_DIR=
# Set absolute paths outside this repository for backups; live requires distinct storage devices.
MEDTRYX_BACKUP_PRIMARY_DIR=
MEDTRYX_BACKUP_SECONDARY_DIR=
PORT=3001
HOST=127.0.0.1
COOKIE_SECURE=true

# Owner bootstrap is available only once, while the selected environment has no users.
MEDTRYX_OWNER_EMAIL=owner@example.test
MEDTRYX_OWNER_PASSWORD=replace-with-a-unique-password-of-at-least-8-characters
